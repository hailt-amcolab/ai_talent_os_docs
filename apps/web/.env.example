# URL của BE (apps/api). Trình duyệt gọi thẳng URL này; BE phải có địa chỉ FE trong CORS_ORIGINS.
# Để rỗng nếu dùng gateway3090/HTTPS cùng origin; dùng URL này nếu mở FE3000 trực tiếp.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Khóa công khai VAPID: PHẢI TRÙNG khóa trong .env gốc (BE dùng cặp khóa đó)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Chỉ khóa publishable của Supabase; frontend chỉ dùng Auth SDK giữ/refresh phiên.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
