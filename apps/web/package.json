{
  "name": "talent-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test 'lib/**/*.test.ts'",
    "icons": "node scripts/gen-icons.mjs",
    "dev:https": "next dev --experimental-https",
    "api:types": "node ../api/tools/export-openapi.ts && openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "e2e:demo": "node e2e/auth-pwa-demo.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "typescript": "^5"
  }
}
