NODE_ENV=development
PORT=8080
# Địa chỉ FE được gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,https://localhost:3000
# Số tiến trình API khi chạy bằng PM2 (cluster)
API_INSTANCES=1

# Supabase PostgreSQL: chép từ Dashboard → Connect, thay mật khẩu (URL-encode nếu có ký tự đặc biệt).
# Runtime dùng transaction pooler 6543; migration dùng session pooler 5432 hoặc direct.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=5
# Chứng chỉ CA khác bản đi kèm certs/supabase-ca.crt (không bắt buộc)
# DATABASE_CA_CERT=/absolute/path/to/ca.crt
