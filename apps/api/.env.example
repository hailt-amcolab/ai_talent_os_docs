NODE_ENV=development
PORT=8080
# Địa chỉ FE được gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:3090
# Số tiến trình API khi chạy bằng PM2 (cluster)
API_INSTANCES=1

# Supabase PostgreSQL: chép từ Dashboard → Connect, thay mật khẩu (URL-encode nếu có ký tự đặc biệt).
# Runtime dùng transaction pooler 6543; migration dùng session pooler 5432 hoặc direct.
DATABASE_URL=postgresql://talent_api.PROJECT_REF:ENCODED_RUNTIME_PASSWORD@POOLER_HOST:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=5
# Chỉ cho migrate dev/diff: DB disposable RIÊNG, không được trùng DIRECT_URL.
# SHADOW_DATABASE_URL=postgresql://migration_user:password@localhost:5433/talent_shadow
# Chứng chỉ CA khác bản đi kèm certs/supabase-ca.crt (không bắt buộc)
# DATABASE_CA_CERT=/absolute/path/to/ca.crt

# Web Push thật: adapter đọc ba biến này khi khởi động.
# Tạo cặp khóa: npx web-push generate-vapid-keys. Public key phải trùng frontend.
VAPID_PUBLIC_KEY=
# Private Key cùng cặp; chỉ ở backend, không đưa vào NEXT_PUBLIC_*.
VAPID_PRIVATE_KEY=
# mailto:<email vận hành> hoặc URL HTTPS của đơn vị vận hành.
VAPID_SUBJECT=

# Demo Auth/PWA chỉ chạy ngoài production. Không bật SMS hoặc tự đăng ký role quản lý.
ENABLE_AUTH_DEMO=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Demo only: tự đăng ký dùng ngay, không SMTP/duyệt đơn; cần SUPABASE_SECRET_KEY ở BE.
DEMO_AUTO_CONFIRM_EMAIL=false
