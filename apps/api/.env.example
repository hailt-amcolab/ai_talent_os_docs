NODE_ENV=development
PORT=8080
# Địa chỉ FE được gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:3090
# Số tiến trình API khi chạy bằng PM2 (cluster)
API_INSTANCES=1

# Supabase PostgreSQL: chép từ Dashboard → Connect, thay mật khẩu (URL-encode nếu có ký tự đặc biệt).
# Runtime dùng transaction pooler 6543; migration dùng session pooler 5432 hoặc direct.
DATABASE_URL=postgresql://talent_api.PROJECT_REF:ENCODED_RUNTIME_PASSWORD@POOLER_HOST:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=5
# Chỉ cho migrate dev/diff: DB disposable RIÊNG, không được trùng DIRECT_URL.
# SHADOW_DATABASE_URL=postgresql://migration_user:password@localhost:5433/talent_shadow
# Chứng chỉ CA khác bản đi kèm certs/supabase-ca.crt (không bắt buộc)
# DATABASE_CA_CERT=/absolute/path/to/ca.crt

# Web Push thật: adapter đọc ba biến này khi khởi động.
# Tạo cặp khóa: npx web-push generate-vapid-keys. Public key phải trùng frontend.
VAPID_PUBLIC_KEY=
# Private Key cùng cặp; chỉ ở backend, không đưa vào NEXT_PUBLIC_*.
VAPID_PRIVATE_KEY=
# mailto:<email vận hành> hoặc URL HTTPS của đơn vị vận hành.
VAPID_SUBJECT=

# Demo Auth/PWA chỉ chạy ngoài production. Không bật SMS hoặc tự đăng ký role quản lý.
ENABLE_AUTH_DEMO=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Demo only: tự đăng ký dùng ngay, không SMTP/duyệt đơn; cần SUPABASE_SECRET_KEY ở BE.
DEMO_AUTO_CONFIRM_EMAIL=false

# Demo OneDrive (Microsoft Graph). Cần ENABLE_AUTH_DEMO=true. Bỏ trống ONEDRIVE_AUTH_MODE → 503 ONEDRIVE_NOT_CONFIGURED.
# Hai chế độ tách hẳn, không tự chuyển sang nhau:
#   delegated: MỘT tài khoản Microsoft chính (Outlook/Hotmail cá nhân hoặc công ty) cho cả hệ thống; người trong ONEDRIVE_ADMIN_EMAILS kết nối một lần, mọi người dùng chung.
#   app:       kho dùng chung của tổ chức, client credentials; CHỈ chạy với tenant Microsoft 365 có SharePoint Online.
ONEDRIVE_AUTH_MODE=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# --- delegated ---
# Authority đăng nhập: common = công ty + cá nhân; consumers = chỉ cá nhân. Không điền Directory (tenant) ID ở đây.
ONEDRIVE_AUTHORITY_TENANT=common
# Phải trùng tuyệt đối Redirect URI loại "Web" trong Entra: <origin FE có trong CORS_ORIGINS>/pwa/onedrive/callback
ONEDRIVE_REDIRECT_URI=
# Email đăng nhập được phép kết nối/ngắt tài khoản Microsoft CHÍNH (cách nhau dấu phẩy). Trống = không ai.
ONEDRIVE_ADMIN_EMAILS=
# Khóa mã hóa token khi lưu DB: openssl rand -base64 32 (đổi khóa = mọi người phải kết nối lại)
ONEDRIVE_TOKEN_KEY=
# --- app ---
# Directory (tenant) ID sở hữu drive và drive id (GET /users/<upn>/drive hoặc /sites/<site-id>/drive).
ONEDRIVE_TENANT_ID=
ONEDRIVE_DRIVE_ID=
# Thư mục gốc của demo trong drive; mọi thao tác chỉ nằm dưới <gốc>/Talents/. Tên thư mục/tệp con: src/modules/ai-coach/context.ts
ONEDRIVE_ROOT_FOLDER=AI_Talent_OS_dev

# Demo kết nối mạng xã hội qua Upload-Post (/api/v1/dev/upload-post/*). Cần ENABLE_AUTH_DEMO=true. Bỏ trống → 503 UPLOAD_POST_NOT_CONFIGURED.
# Gói Free: 2 hồ sơ, 10 lần đăng/tháng, không đăng được TikTok.
UPLOAD_POST_API_KEY=

# Agent core (agent_spec/AI_Talent_OS_AI_Core_Architecture_Report_v2.md). API /api/v1/me/agent/* (Talent) và /api/v1/admin/agent/* (Manager, phiên TOTP aal2).
# Hiện cần ENABLE_AUTH_DEMO=true (chưa có adapter Auth production). Mặc định tắt; ghi (prepare/xác nhận/commit) có công tắc riêng.
ENABLE_AGENT_CORE=false
ENABLE_AGENT_WRITES=false
# Giới hạn kỹ thuật của MỘT lượt (mặc định staging, không phải luật nghiệp vụ/SLA)
AGENT_MODEL_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_COMPUTE_TIMEOUT_MS=120000
AGENT_MODEL_TIMEOUT_MS=45000
# Hạn của một đề xuất thay đổi chờ Manager xác nhận (giây)
AGENT_APPROVAL_TTL_SECONDS=600
AGENT_INTERACTIVE_CONCURRENCY=1
# API chỉ ghi Postgres; các biến dưới đây do WORKER đọc (npm run worker, hoặc service `worker` trong docker-compose).
# Redis cho BullMQ. docker-compose tự đặt redis://redis:6379; chạy tay trên máy: redis://127.0.0.1:6379
REDIS_URL=
# Tiền tố khóa Redis theo môi trường (mặc định talentos-<NODE_ENV>)
AI_QUEUE_PREFIX=
# Khóa OpenAI riêng của dự án. Chỉ ở BE/worker, không đưa vào NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Không bắt buộc: endpoint tương thích OpenAI (proxy/gateway). Bỏ trống = api.openai.com
OPENAI_BASE_URL=
# Model bắt buộc, không có mặc định
AI_COACH_MODEL=
# Giá trên 1 triệu token: điền cả hai thì mỗi model step có cost; bỏ trống thì chỉ lưu số token, cost NULL (không ghi 0 giả)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_CURRENCY=USD
