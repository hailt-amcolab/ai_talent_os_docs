// Current contracts: agent_spec/auth-pwa-demo/IMPLEMENTATION.md.
// Provider Auth projection is external; SQL owns CHECK/trigger/ACL.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  previewFeatures        = ["partialIndexes"]
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app_private", "auth", "public"]
}

