// Hướng dẫn dùng các bảng Auth/push: agent_spec/supabase-db-auth-spec/HUONG_DAN_TICH_HOP_VI.md §5.4.
// Provider Auth projection is external; SQL owns CHECK/trigger/ACL.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  previewFeatures        = ["partialIndexes"]
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app_private", "auth", "public"]
}

