model activity_logs {
  id               BigInt    @id(map: "pk_activity_logs") @default(autoincrement())
  actor_type       String
  actor_manager_id String?   @db.Uuid
  actor_talent_id  String?   @db.Uuid
  action           String
  target_type      String?
  target_id        String?
  result           String?
  details          Json?
  occurred_at      DateTime  @default(now()) @db.Timestamptz(6)
  managers         managers? @relation(fields: [actor_manager_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_activity_logs_actor_manager_id")
  talents          talents?  @relation(fields: [actor_talent_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_activity_logs_actor_talent_id")

  @@index([actor_manager_id], map: "idx_activity_logs_actor_manager_id", where: raw("(actor_manager_id IS NOT NULL)"))
  @@index([actor_talent_id], map: "idx_activity_logs_actor_talent_id", where: raw("(actor_talent_id IS NOT NULL)"))
  @@index([occurred_at(sort: Desc)], map: "idx_activity_logs_occurred_at")
  @@index([target_type, target_id, occurred_at(sort: Desc)], map: "idx_activity_logs_target")
  @@schema("public")
}

