# Giá trị dùng chung cho docker compose (thư mục gốc). Kết nối DB nằm ở apps/api/.env.
# URL mà TRÌNH DUYỆT dùng để gọi BE (gắn vào FE lúc build).
PUBLIC_API_URL=http://localhost:8080
# Địa chỉ FE được gọi BE, cách nhau bằng dấu phẩy (thêm URL đường hầm HTTPS khi thử trên điện thoại)
CORS_ORIGINS=http://localhost:3000,https://localhost:3000
API_INSTANCES=1
# Khóa công khai VAPID cho FE (tạo: npx web-push generate-vapid-keys). Khóa bí mật thêm vào apps/api/.env khi BE có tính năng gửi push.
VAPID_PUBLIC_KEY=BK0lXyGpir_SS30VkRiw8MA_jK46E8o4ObYXkfW7V2fXgCC49xnqSMQc1ePBbUmumpKW2MCncKXS8oH7wVkTyJ0
# Chỉ khi dùng PostgreSQL local (profile local-db)
POSTGRES_PASSWORD=
# Mặc định production; chỉ đổi development khi chủ động chạy demo.
APP_ENV=production
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
