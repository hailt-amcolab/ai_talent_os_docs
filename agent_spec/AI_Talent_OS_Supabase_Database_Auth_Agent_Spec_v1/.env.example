# PLACEHOLDERS ONLY, never commit real secrets
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_KEY
SUPABASE_SECRET_KEY=SERVER_ONLY_REPLACE_IN_SECRET_STORE
DATABASE_URL=postgresql://RUNTIME_ROLE:PASSWORD@POOLER_HOST:6543/postgres
MIGRATION_DATABASE_URL=postgresql://MIGRATION_ROLE:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres
EMAIL_HASH_PEPPER=SERVER_ONLY_REPLACE_IN_SECRET_STORE
MFA_RECOVERY_CODES_EXPERIMENTAL_ENABLED=false
# Typed config must parse these; strings false are not truthy feature flags.

# CR-MFA-02: default Authenticator, SMS support is optional and not enabled here.
MFA_SMS_RESEND_COOLDOWN_SECONDS=60
MFA_SMS_MAX_VERIFY_ATTEMPTS=5
MFA_SMS_PROVIDER=SELECT_PROVIDER_BEFORE_RELEASE
# Provider credentials belong in Supabase Dashboard/secret store; never NEXT_PUBLIC.

MANAGER_MFA_ALLOWED_METHODS=totp
MANAGER_MFA_PREFERRED_METHOD=totp
MFA_SMS_ENABLED=false
LOGIN_LOCK_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# After customer decision + provider configuration, allowed methods can be totp,phone_sms.
