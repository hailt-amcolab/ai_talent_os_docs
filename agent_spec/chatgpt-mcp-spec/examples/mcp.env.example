# ĐỀ XUẤT: ứng dụng hiện chưa đọc các biến này. Không chứa khóa thật.
# BE only; tên issuer/client/scope phải chốt bằng POC, không sao chép placeholder lên prod.
MCP_ENABLED=false
MCP_PROFILE_WRITE_ENABLED=false
MCP_RESOURCE_URI=https://api.example.jp/mcp
MCP_AUTH_ISSUER=https://authorization.example.jp
MCP_AUTH_JWKS_URI=https://authorization.example.jp/.well-known/jwks.json
MCP_ALLOWED_CLIENT_IDS=replace-with-verified-client-id
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://app.example.jp
MCP_APPROVAL_WEB_ORIGIN=https://app.example.jp
MCP_PROPOSAL_TTL_SECONDS=600
MCP_MAX_REQUEST_BYTES=65536
MCP_MAX_PROFILE_BYTES=131072
MCP_REQUESTS_PER_MINUTE=30
MCP_COMMITS_PER_MINUTE=5
# Không có NEXT_PUBLIC secret, Graph token, service_role hoặc OpenAI API key ở đây.
# Scope, discovery endpoints và token policy: chốt ADR trước khi thêm env parser.

# BullMQ + Redis đã chốt trong kiến trúc chung. Tái sử dụng cấu hình worker/Redis
# khi được bổ sung vào env parser; không tạo MCP_REDIS_URL hay secret kho riêng.
# MCP_ENABLED độc lập ENABLE_AUTH_DEMO. Production không dùng danh tính demo.
# MCP_RESOURCE_URI là resource token phải được AS/ChatGPT POC xác nhận,
# không chỉ lấy biến này để tự đổi hoặc bỏ kiểm tra aud.
