{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-talent-os.invalid/contracts/pwa/v1",
  "title": "Proposed internal Talent PWA schemas — validate named $defs",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "fieldErrors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "queued",
            "running",
            "completed",
            "failed",
            "unknown"
          ]
        },
        "statusUrl": {
          "type": "string",
          "pattern": "^/api/v1/operations/[^/?#]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "type": "object",
          "description": "DTO theo kind, phải thay bằng discriminated union domain khi code; không trả raw provider payload"
        },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "operationId",
        "status",
        "statusUrl",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "Command": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "commandId"
      ],
      "additionalProperties": false
    },
    "PreferencesPatch": {
      "type": "object",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "locale": {
          "type": "string",
          "enum": [
            "ja",
            "vi"
          ]
        }
      },
      "required": [
        "expectedVersion",
        "locale"
      ],
      "additionalProperties": false
    },
    "CoachMessageCreate": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "clientMessageId": {
          "type": "string",
          "format": "uuid"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "commandId",
        "clientMessageId",
        "threadId",
        "text"
      ],
      "additionalProperties": false
    },
    "DraftCreate": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string",
          "enum": [
            "suggestion",
            "own_idea"
          ]
        },
        "suggestionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "suggestionSetVersion": {
          "type": "integer",
          "minimum": 1
        },
        "idea": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "commandId",
        "source"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "suggestion"
              }
            }
          },
          "then": {
            "required": [
              "suggestionId",
              "suggestionSetVersion"
            ],
            "not": {
              "required": [
                "idea"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "own_idea"
              }
            }
          },
          "then": {
            "required": [
              "idea"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "suggestionId"
                  ]
                },
                {
                  "required": [
                    "suggestionSetVersion"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "DraftRevisionCreate": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "commandId",
        "expectedVersion",
        "instruction"
      ],
      "additionalProperties": false
    },
    "DraftMediaPatch": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "mediaIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "commandId",
        "expectedVersion",
        "mediaIds"
      ],
      "additionalProperties": false
    },
    "DraftAdopt": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "commandId",
        "expectedVersion",
        "revisionId"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "amountMinor": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false
    },
    "VideoQuoteRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "short",
            "slideshow"
          ]
        },
        "photoIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "draftRevisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "photoIds"
      ],
      "additionalProperties": false
    },
    "VideoQuote": {
      "type": "object",
      "properties": {
        "quoteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "inputDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "price": {
          "$ref": "#/$defs/Money"
        },
        "priceMode": {
          "type": "string",
          "enum": [
            "estimated",
            "guaranteed"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "estimatedDurationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "pricingTermsId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "quoteId",
        "inputDigest",
        "price",
        "priceMode",
        "expiresAt",
        "policyVersion",
        "estimatedDurationSeconds",
        "pricingTermsId"
      ],
      "additionalProperties": false
    },
    "VideoGenerationCreate": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "quoteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "acceptedPricingTermsId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "commandId",
        "quoteId",
        "acceptedPricingTermsId"
      ],
      "additionalProperties": false
    },
    "UploadSessionCreate": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "commandId",
        "fileName",
        "sizeBytes",
        "mimeType"
      ],
      "additionalProperties": false
    },
    "UploadSession": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "uploading",
            "verifying",
            "ready",
            "failed",
            "aborted",
            "expired"
          ]
        },
        "acknowledgedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "chunkSizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "transport": {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string",
              "enum": [
                "tus"
              ]
            },
            "endpoint": {
              "type": "string",
              "pattern": "^https://[a-z0-9-]+\\.supabase\\.co/storage/v1/upload/resumable$"
            },
            "bucket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "objectName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "uploadToken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "protocol",
            "endpoint",
            "bucket",
            "objectName"
          ],
          "additionalProperties": false,
          "description": "Tải thẳng lên Supabase Storage bằng TUS. objectName do server sinh theo talent_id. uploadToken ngắn hạn nếu POC xác nhận dùng được với TUS; nếu không, client dùng session Supabase của chính tài năng."
        }
      },
      "required": [
        "sessionId",
        "assetId",
        "state",
        "acknowledgedBytes",
        "totalBytes",
        "chunkSizeBytes",
        "expiresAt",
        "transport"
      ],
      "additionalProperties": false
    },
    "UploadComplete": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedTotalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "commandId",
        "expectedTotalBytes"
      ],
      "additionalProperties": false
    },
    "PushSubscriptionBind": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "format": "uuid"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "keys": {
          "type": "object",
          "properties": {
            "p256dh": {
              "type": "string",
              "minLength": 1
            },
            "auth": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "p256dh",
            "auth"
          ],
          "additionalProperties": false
        },
        "expirationTime": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "deviceId",
        "endpoint",
        "keys",
        "expirationTime"
      ],
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "coach",
                "draft",
                "post",
                "video",
                "connections",
                "billing",
                "mypage"
              ]
            },
            "resourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "readAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "body",
        "target",
        "createdAt",
        "readAt"
      ],
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "freshness": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unavailable"
          ]
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "collectedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "key",
        "value",
        "unit",
        "freshness",
        "unavailableReason",
        "collectedAt"
      ],
      "additionalProperties": false
    },
    "BillingSetupCreate": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "commandId"
      ],
      "additionalProperties": false
    },
    "ConsentCreate": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "documentType": {
          "type": "string",
          "enum": [
            "terms",
            "privacy"
          ]
        },
        "documentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accepted": {
          "const": true
        }
      },
      "required": [
        "commandId",
        "documentType",
        "documentVersion",
        "accepted"
      ],
      "additionalProperties": false
    },
    "OnboardingPatch": {
      "type": "object",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "step": {
          "type": "string",
          "enum": [
            "install",
            "push",
            "billing",
            "social"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "completed",
            "skipped"
          ]
        }
      },
      "required": [
        "expectedVersion",
        "step",
        "disposition"
      ],
      "additionalProperties": false
    }
  }
}