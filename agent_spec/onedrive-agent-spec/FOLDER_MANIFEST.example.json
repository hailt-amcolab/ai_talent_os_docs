{
  "schemaVersion": 1,
  "status": "Đề xuất bản 1.1, thống nhất với SCD/EP02/2-2; cần phê duyệt storage binding (S02-02) và ownership",
  "identity_key": [
    "ms_tenant_id",
    "drive_id",
    "item_id"
  ],
  "talent_root_template": "タレント/<talent_uuid>_<表示名>",
  "roles": [
    {
      "path": "_system/identity.json",
      "owner": "database",
      "import_to_ai": false,
      "manual_edit": "forbidden"
    },
    {
      "path": "プロフィール.md",
      "owner": "onedrive",
      "import_to_ai": true,
      "manual_edit": "manager_or_mcp_confirmed",
      "required_sections": [
        "プロフィール",
        "方向性",
        "趣味・特技",
        "将来の目標",
        "チャレンジ",
        "日付",
        "個別の指示"
      ]
    },
    {
      "path": "AIメモ.md",
      "owner": "onedrive",
      "import_to_ai": true,
      "manual_edit": "manager",
      "writer": "ai_worker_conditional_etag"
    },
    {
      "path": "目標.md",
      "owner": "database",
      "import_to_ai": "from_database_snapshot",
      "manual_edit": "not_imported",
      "schema": "GoalsExport"
    },
    {
      "path": "実績/サマリー.md",
      "owner": "database",
      "import_to_ai": "from_database_snapshot",
      "manual_edit": "not_imported"
    },
    {
      "path": "実績/<YYYY-MM>.csv",
      "owner": "database",
      "import_to_ai": false,
      "manual_edit": "not_imported"
    },
    {
      "path": "実績/snapshots/<YYYY>/<MM>/<date>_<snapshot_uuid>.json",
      "owner": "database",
      "import_to_ai": "from_database_snapshot",
      "manual_edit": "not_imported"
    },
    {
      "path": "素材/originals/<YYYY>/<MM>/<asset_uuid>.<ext>",
      "owner": "onedrive_bytes_database_metadata",
      "import_to_ai": false,
      "manual_edit": "worker_copy_from_supabase"
    },
    {
      "path": "素材/AI生成/<YYYY>/<MM>/<asset_uuid>.<ext>",
      "owner": "onedrive_bytes_database_metadata",
      "import_to_ai": false,
      "manual_edit": "worker_copy_from_supabase"
    },
    {
      "path": "添付",
      "owner": "onedrive",
      "import_to_ai": "only_validated_allowlist",
      "manual_edit": "manager"
    }
  ],
  "common_roots": [
    "common/knowledge",
    "common/exports"
  ],
  "security_note": "Paths are labels only; access must use server-side mapped IDs and roles.",
  "common_root": "共通",
  "common_roles": [
    {
      "path": "共通/ノウハウ.md",
      "owner": "onedrive",
      "import_to_ai": true,
      "manual_edit": "manager"
    },
    {
      "path": "共通/アルゴリズム対策.md",
      "owner": "onedrive",
      "import_to_ai": true,
      "manual_edit": "manager"
    },
    {
      "path": "共通/AIへの指示.md",
      "owner": "onedrive",
      "import_to_ai": true,
      "manual_edit": "manager_or_mcp_confirmed"
    }
  ]
}